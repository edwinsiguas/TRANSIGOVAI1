# ==========================================
# Estándares de Indexación y Metadatos (DevOps)
# ==========================================
*.java linguist-detectable=true
*.ts linguist-detectable=true
*.tsx linguist-detectable=true

# Exclusión de librerías vendoreadas
frontend/components/** linguist-vendored
frontend/src/components/ui/** linguist-vendored
frontend/hooks/** linguist-vendored

# Exclusión de dependencias generadas por el gestor de paquetes
package-lock.json linguist-generated
frontend/package-lock.json linguist-generated
*.map linguist-generated
