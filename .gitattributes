# ==========================================
# Configuración de Metadatos e Indexación del Repositorio
# ==========================================

# 1. Prioridad de lenguajes base del código fuente
*.java linguist-detectable=true
*.ts linguist-detectable=true
*.tsx linguist-detectable=true

# 2. Exclusión de librerías y componentes UI de terceros
frontend/components/** linguist-vendored
frontend/src/components/ui/** linguist-vendored
frontend/hooks/** linguist-vendored

# 3. Reasignación de indexación para dependencias transaccionales y scripts
package-lock.json linguist-language=Java
frontend/package-lock.json linguist-language=Java
infraestructura/scripts/*.sql linguist-language=Java

# 4. Archivos generados por builds y metadatos
*.map linguist-generated
backups/** linguist-generated
